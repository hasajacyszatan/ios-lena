From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lena <lena@x>
Date: Tue, 27 Oct 2026 15:00:00 +0100
Subject: [PATCH] lena-0158: one busy heartbeat per CPU, and the syscalls that
 never return

The 0157 boot (ring /tmp/opencode/log0157.txt, total 67196) froze at kernel
time 37 s: the 1 s heartbeat, the 2 s process dump and the busy heartbeat all
went silent at 37 s, while the console kept receiving 19 KB - the tail of the
auearlyboot/tzinit/prng_seedctl spawns - so the machine was alive for at least
a fraction of a second after the last diagnostic line. Only one busy thread
existed, though, and it may have been the thread on the CPU that hung.

Two instruments:

1. SWEET HBB per CPU. sweet_diag_start() now starts one busy thread per CPU
   (the cpus boot-arg, capped at 8); each never sleeps and never calls printf,
   prints its own cpu_number() once a second, and the unit index separately so
   a thread that migrates is visible. A per-CPU hang then shows as one silent
   unit among live ones; only a machine-wide freeze silences all of them.

2. SWEET STUCK. bsd/dev/arm/systemcalls.c keeps a 128-slot table of what every
   thread is inside right now: entry stores pid/code/timestamp and publishes the
   tid, exit clears the tid. Every busy thread prints the entries older than
   1.5 s straight into the ring, at most six at a time. The last snapshot before
   a freeze therefore names the syscall that was already hanging, which the
   0157 sequential trace could not do: it prints only the first 40 calls of pids
   14..45, so anything later (launchd itself, or a pid past its budget) is
   invisible.
---
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -66,6 +66,107 @@
 
 static uint16_t sweet_sys_seen[SWEET_SYS_PID_HI - SWEET_SYS_PID_LO];
 
+/*
+ * 0158: which syscall is running RIGHT NOW, on every thread.
+ *
+ * The 0157 boot froze with every one of our diagnostics (heartbeat, process
+ * dump, busy heartbeat) silent at the same second, and its syscall trace ended
+ * without a single "in" lacking its "out" - but that trace prints only the
+ * first 40 syscalls of pids 14..45, so a later syscall (from launchd itself, or
+ * from a pid past its budget) that never returned is completely invisible.
+ *
+ * The table below records, per thread, the syscall it is inside and when it
+ * entered: entry writes the fields and then publishes the tid, exit clears the
+ * tid. The busy heartbeat thread prints every entry older than 1.5 s straight
+ * into the ring, so the last snapshot before a freeze names the syscall that
+ * was already hanging at that moment - no post-mortem needed. Table entries are
+ * advisory (a thread that dies inside a syscall leaves its entry behind), but a
+ * stale entry can only over-report, never hide a real hang.
+ */
+#define SWEET_INFLIGHT_SLOTS    128
+#define SWEET_INFLIGHT_SLOW_NS  (1500ULL * NSEC_PER_MSEC)
+#define SWEET_INFLIGHT_REPORT   6
+
+struct sweet_inflight {
+	volatile uint64_t si_tid;
+	volatile uint64_t si_start;
+	volatile int32_t  si_pid;
+	volatile int32_t  si_code;
+};
+
+static struct sweet_inflight sweet_inflight[SWEET_INFLIGHT_SLOTS];
+
+static uint32_t
+sweet_inflight_slot(uint64_t tid)
+{
+	return (uint32_t)((tid >> 4) ^ (tid >> 11)) & (SWEET_INFLIGHT_SLOTS - 1);
+}
+
+static void
+sweet_inflight_enter(pid_t pid, int code, uint64_t tid)
+{
+	struct sweet_inflight *e = &sweet_inflight[sweet_inflight_slot(tid)];
+
+	e->si_pid = pid;
+	e->si_code = code;
+	e->si_start = mach_absolute_time();
+	os_atomic_store(&e->si_tid, tid, release);
+}
+
+static void
+sweet_inflight_exit(uint64_t tid)
+{
+	struct sweet_inflight *e = &sweet_inflight[sweet_inflight_slot(tid)];
+
+	if (os_atomic_load(&e->si_tid, acquire) == tid) {
+		os_atomic_store(&e->si_tid, 0, release);
+	}
+}
+
+void sweet_sys_report_slow(void);       /* called from bsd/kern/bsd_init.c */
+
+void
+sweet_sys_report_slow(void)
+{
+	uint64_t now = mach_absolute_time();
+	int shown = 0;
+
+	for (int i = 0; i < SWEET_INFLIGHT_SLOTS; i++) {
+		struct sweet_inflight *e = &sweet_inflight[i];
+		uint64_t tid = os_atomic_load(&e->si_tid, acquire);
+		uint64_t ns = 0;
+		pid_t pid;
+		int code;
+		const char *name = "?";
+
+		if (tid == 0) {
+			continue;
+		}
+		pid = e->si_pid;
+		code = e->si_code;
+		absolutetime_to_nanoseconds(now - e->si_start, &ns);
+		if (os_atomic_load(&e->si_tid, acquire) != tid ||
+		    ns < SWEET_INFLIGHT_SLOW_NS) {
+			continue;
+		}
+		if (code >= 0 && code < nsysent && syscallnames[code] != NULL) {
+			name = syscallnames[code];
+		}
+		sweet_ring_str("SWEET STUCK: pid ");
+		sweet_ring_int(pid);
+		sweet_ring_str(" code ");
+		sweet_ring_int(code);
+		sweet_ring_str(" ");
+		sweet_ring_str(name);
+		sweet_ring_str(" for ");
+		sweet_ring_num(ns / NSEC_PER_SEC);
+		sweet_ring_str("s\n");
+		if (++shown >= SWEET_INFLIGHT_REPORT) {
+			break;
+		}
+	}
+}
+
 static void
 sweet_sys_trace(pid_t pid, int code, boolean_t enter, int error)
 {
@@ -167,6 +268,7 @@
 
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	sweet_sys_trace(proc_pid(proc), syscode, TRUE, 0);
+	sweet_inflight_enter(proc_pid(proc), syscode, thread_tid(thread_act));
 #endif
 
 	/*
@@ -248,6 +350,7 @@
 
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	sweet_sys_trace(pid, syscode, FALSE, error);
+	sweet_inflight_exit(thread_tid(thread_act));
 #endif
 
 #ifdef CONFIG_IOCOUNT_TRACE
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -543,16 +543,36 @@
  *
  * The line keeps coming while the kernel is alive, and `hb`/`ps` say whether
  * the sleeping threads are inside printf (enter > exit) or never woke up.
+ *
+ * 0158: one thread per CPU instead of one.
+ *
+ * The 0157 boot froze with all three diagnostics silent at the same second
+ * (37 s) while the console kept receiving syscalls for another 19 KB, so a
+ * single busy thread cannot tell "one CPU hung, the others are fine" from "the
+ * whole machine is gone" - it may simply be the thread on the dead CPU. With
+ * one busy thread per CPU, each printing its own cpu_number() once a second,
+ * a per-CPU hang shows up as one silent line among live ones, and only a
+ * machine-wide freeze silences all of them. Each thread also asks the syscall
+ * trace (bsd/dev/arm/systemcalls.c) for the syscalls that have been in flight
+ * for more than 1.5 s, so the last snapshot before a freeze names the call
+ * that was already hanging.
  */
+extern int cpu_number(void);            /* osfmk/arm/cpu_number.h */
+extern void sweet_sys_report_slow(void); /* bsd/dev/arm/systemcalls.c */
+
 static void
 sweet_diag_busy(void *arg, wait_result_t wr)
 {
 	uint64_t last = mach_absolute_time();
 	uint64_t secs = 0;
+	int unit = (int)(uintptr_t)arg;
 
-	(void)arg;
 	(void)wr;
-	sweet_ring_str("SWEET HBB: busy heartbeat thread started\n");
+	sweet_ring_str("SWEET HBB: busy thread ");
+	sweet_ring_num((uint64_t)unit);
+	sweet_ring_str(" running on cpu ");
+	sweet_ring_num((uint64_t)cpu_number());
+	sweet_ring_str("\n");
 	for (;;) {
 		uint64_t ns = 0;
 
@@ -562,7 +582,11 @@
 		}
 		last = mach_absolute_time();
 		secs++;
-		sweet_ring_str("SWEET HBB: alive ");
+		sweet_ring_str("SWEET HBB: unit ");
+		sweet_ring_num((uint64_t)unit);
+		sweet_ring_str(" cpu ");
+		sweet_ring_num((uint64_t)cpu_number());
+		sweet_ring_str(" alive ");
 		sweet_ring_num(secs);
 		sweet_ring_str("s ring ");
 		sweet_ring_num(sweet_log_position());
@@ -575,6 +599,7 @@
 		sweet_ring_str("/");
 		sweet_ring_num(sweet_ps_exit);
 		sweet_ring_str("\n");
+		sweet_sys_report_slow();
 	}
 }
 
@@ -766,8 +791,22 @@
 	if (kernel_thread_start(sweet_diag_procs_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
-	if (kernel_thread_start(sweet_diag_busy, NULL, &thread) == KERN_SUCCESS) {
-		thread_deallocate(thread);
+	{
+		int ncpu = 4;           /* same default as the cpus boot-arg */
+
+		PE_parse_boot_argn("cpus", &ncpu, sizeof(ncpu));
+		if (ncpu < 1) {
+			ncpu = 1;
+		}
+		if (ncpu > 8) {
+			ncpu = 8;
+		}
+		for (int i = 0; i < ncpu; i++) {
+			if (kernel_thread_start(sweet_diag_busy, (void *)(uintptr_t)i,
+			    &thread) == KERN_SUCCESS) {
+				thread_deallocate(thread);
+			}
+		}
 	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
