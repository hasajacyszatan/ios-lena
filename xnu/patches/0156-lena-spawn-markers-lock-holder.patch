--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1032,11 +1032,32 @@
 {
 	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
 	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
-	uint64_t pos = total - sweet_log_flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : sweet_log_flushed;
+	uint64_t flushed = sweet_log_flushed;
+	uint64_t pos;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
 	int error = 0;
 	int cmds = 0;
 
+	/*
+	 * 0156: the copy below moves `pos` to a block boundary, so after a flush
+	 * `sweet_log_flushed` can sit up to one block past `total`. The next
+	 * flush then evaluated total - flushed, which wrapped to ~2^64, counted
+	 * as "the reader fell more than a ring behind", and set
+	 *
+	 *     pos = total - SWEET_LOG_SIZE
+	 *
+	 * - an address before the beginning of the ring. `pos < total` is then
+	 * false for a while, so the data copy is skipped and only the header is
+	 * rewritten, storing that impossible position as the advertised total:
+	 * the 0155 pull read `total = 18446744073705393439` = 36127 - 4 MiB,
+	 * i.e. the persisted log appeared to end 4 MiB before it started, and
+	 * every later pull lost the newest lines. Recover instead of wrapping.
+	 */
+	if (flushed > total) {
+		flushed = total > SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : 0;
+	}
+	pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
+
 	while (pos < total && !error) {
 		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
 		uint32_t blk = off / UFS_BLOCK;
@@ -1051,6 +1072,14 @@
 			break;
 		}
 	}
+	/*
+	 * 0156: never advertise or remember bytes past the end of the console
+	 * data. A block-rounded position past `total` is exactly what set up the
+	 * wrap described above, so clamp it back to the truth here as well.
+	 */
+	if (pos > total) {
+		pos = total;
+	}
 	if (!error) {
 		struct sweet_log_header h = {
 			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -533,6 +533,16 @@
  */
 extern unsigned int vm_page_free_count;
 
+/*
+ * 0156: the proc_list_lock() bookkeeping from bsd/kern/kern_fork.c, so a
+ * skipped dump can name the thread that owns the lock instead of just saying
+ * "busy".
+ */
+extern void *sweet_plock_holder;
+extern int sweet_plock_holder_pid;
+extern uintptr_t sweet_plock_site;
+extern uint64_t sweet_plock_held_since;
+
 #define SWEET_PS_MAX 192
 
 /*
@@ -560,7 +570,29 @@
 	int n = 0;
 	int i;
 
-	proc_list_lock();
+	/*
+	 * 0156: never block on the list lock. A dump thread parked on it is
+	 * silent by definition - the 0155 boot printed not one SWEET PS line in
+	 * 600 s while the heartbeat kept printing - and "the list lock is stuck
+	 * in this thread" is itself the answer, so report the holder and skip
+	 * this round.
+	 */
+	if (!lck_mtx_try_lock(&proc_list_mlock)) {
+		uint64_t held_ms = 0;
+
+		if (sweet_plock_holder != NULL && sweet_plock_held_since != 0) {
+			uint64_t ns = 0;
+
+			absolutetime_to_nanoseconds(mach_absolute_time() -
+			    sweet_plock_held_since, &ns);
+			held_ms = ns / NSEC_PER_MSEC;
+		}
+		printf("SWEET PS: proc_list_mlock busy, dump skipped: holder pid %d thread 0x%llx site 0x%llx held %llu ms\n",
+		    sweet_plock_holder_pid,
+		    (uint64_t)(uintptr_t)sweet_plock_holder,
+		    (uint64_t)sweet_plock_site, held_ms);
+		return;
+	}
 	for (p = allproc.lh_first; p != NULL && n < SWEET_PS_MAX;
 	    p = p->p_list.le_next) {
 		pids[n++] = p->p_pid;
@@ -574,7 +606,17 @@
 		if ((p = proc_find(pids[i])) == NULL) {
 			continue;
 		}
-		proc_lock(p);
+		/*
+		 * 0156: same rule for p_mlock - try, report, skip. Waiting here
+		 * would hide the one process whose lock is stuck, which is
+		 * precisely the interesting one.
+		 */
+		if (!lck_mtx_try_lock(&p->p_mlock)) {
+			printf("SWEET PS: %5d p_mlock busy, skipped\n",
+			    (int)p->p_pid);
+			proc_rele(p);
+			continue;
+		}
 		/* 0154: also show the parent, the P_* flags and the thread count -
 		 * one boot should be enough to tell "never started" (absent),
 		 * "stuck in exec" (P_WEXIT/P_EXEC) and "blocked" (wchan) apart. */
@@ -602,6 +644,7 @@
 {
 	int period = 5000;                      /* boot-arg sweetps_ms */
 	bool announced = FALSE;
+	uint32_t dumps = 0;
 
 	PE_parse_boot_argn("sweetps_ms", &period, sizeof(period));
 	if (period < 500) {
@@ -628,6 +671,13 @@
 			announced = TRUE;
 			printf("SWEET PS: process dump every %d ms (pid state name @wchan)\n", period);
 		}
+		/*
+		 * 0156: a start line before every dump, paired with the
+		 * "N processes" trailer. If a dump begins and never ends, the
+		 * next boot's log says that the stuck call is between the two,
+		 * even when nothing inside the walk printed anything.
+		 */
+		printf("SWEET PS: dump %u start\n", ++dumps);
 		sweet_diag_procs();
 	}
 }
--- a/bsd/kern/kern_fork.c
+++ b/bsd/kern/kern_fork.c
@@ -118,6 +118,10 @@
 #include <security/audit/audit.h>
 
 #include <mach/mach_types.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <kern/clock.h>                 /* 0156: mach_absolute_time() for the lock report */
+#endif
 #include <kern/coalition.h>
 #include <kern/kern_types.h>
 #include <kern/kalloc.h>
@@ -1235,6 +1239,71 @@
 	lck_spin_unlock(&p->p_slock);
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * 0156: who holds proc_list_mlock, and from where.
+ *
+ * In the 0155 boot the process-dump thread printed not one line in 600 s
+ * while the heartbeat thread kept printing, and the machine went idle right
+ * after `exec launchd_cache_loader`. A thread parked on a mutex is invisible
+ * from inside the kernel, so the lock has to say who took it: record the
+ * holder's thread, pid, the return address of the proc_list_lock() caller and
+ * the acquisition time, and have the dump thread print them when it cannot
+ * get the lock. Also complain once a second if a waiter has to block that
+ * long, which is already pathological (the lock is only held for short walks).
+ */
+void *sweet_plock_holder;               /* struct thread * */
+int sweet_plock_holder_pid = -1;
+uintptr_t sweet_plock_site;
+uint64_t sweet_plock_held_since;        /* mach absolute time, 0 = free */
+static uint64_t sweet_plock_last_report;
+
+extern struct proc *current_proc(void);
+
+void
+proc_list_lock(void)
+{
+	uint64_t now = mach_absolute_time();
+
+	if (!lck_mtx_try_lock(&proc_list_mlock)) {
+		uint64_t since_report_ns = NSEC_PER_SEC;
+
+		if (sweet_plock_last_report != 0) {
+			absolutetime_to_nanoseconds(now - sweet_plock_last_report,
+			    &since_report_ns);
+		}
+		if (since_report_ns >= NSEC_PER_SEC) {
+			uint64_t held_ns = 0;
+
+			sweet_plock_last_report = now;
+			if (sweet_plock_holder != NULL && sweet_plock_held_since != 0) {
+				absolutetime_to_nanoseconds(now - sweet_plock_held_since,
+				    &held_ns);
+			}
+			printf("SWEET LOCK: proc_list_mlock busy: waiter 0x%llx, holder pid %d thread 0x%llx site 0x%llx held %llu ms\n",
+			    (uint64_t)(uintptr_t)__builtin_return_address(0),
+			    sweet_plock_holder_pid,
+			    (uint64_t)(uintptr_t)sweet_plock_holder,
+			    (uint64_t)sweet_plock_site, held_ns / NSEC_PER_MSEC);
+		}
+		lck_mtx_lock(&proc_list_mlock);
+	}
+	sweet_plock_holder = current_thread();
+	sweet_plock_holder_pid = current_proc() != NULL ? proc_pid(current_proc()) : -1;
+	sweet_plock_site = (uintptr_t)__builtin_return_address(0);
+	sweet_plock_held_since = mach_absolute_time();
+}
+
+void
+proc_list_unlock(void)
+{
+	sweet_plock_holder = NULL;
+	sweet_plock_holder_pid = -1;
+	sweet_plock_site = 0;
+	sweet_plock_held_since = 0;
+	lck_mtx_unlock(&proc_list_mlock);
+}
+#else /* !ARM64_BOARD_CONFIG_SWEET */
 void
 proc_list_lock(void)
 {
@@ -1246,6 +1315,7 @@
 {
 	lck_mtx_unlock(&proc_list_mlock);
 }
+#endif /* ARM64_BOARD_CONFIG_SWEET */
 
 void
 proc_ucred_lock(proc_t p)
