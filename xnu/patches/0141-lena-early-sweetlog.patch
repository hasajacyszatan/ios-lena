From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lena <lena@x>
Date: Sun, 25 Oct 2026 01:40:00 +0200
Subject: [PATCH] lena-0141: persistent console log starts before IOKit matching

With sweetdiag=1 the UFS host and the SWEETLOG writer come up right before
PE_lockdown_iokit() spawns the matching thread, so a driver that hangs on
unported MMIO is still recorded on the partition and can be read from a
recovery with tools/sweet-log-pull.sh instead of filming the screen.

devfs nodes (/dev/ufsroot0, /dev/rufsroot0) move into an idempotent helper:
devfs does not exist before vfsinit(), so an early start can only register
bdevsw/cdevsw, and the root mount completes the node creation. The flush
cadence drops to 100 ms under sweetdiag=1 and the first flush happens before
any sleep.
---
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 3f5eede..9ec3d1a 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -684,8 +684,44 @@ static const struct cdevsw sweet_ufs_cdevsw = {
 	.d_type       = D_DISK,
 };
 
+static bool sweet_ufs_dev_done = false;    /* bdevsw/cdevsw registered */
+static bool sweet_ufs_nodes_done = false;  /* /dev nodes created */
+
+/*
+ * lena: the /dev nodes can only be created once devfs exists (devfs_sinit()
+ * runs from vfsinit(), i.e. inside bsd_init). An early start of the log runs
+ * before that, so registration and node creation are separate, idempotent
+ * steps that the root mount (IOFindBSDRoot -> sweet_ufs_rootdev) completes.
+ * The mount itself only needs the dev_t, which bdevsw_add() gives us.
+ * Returns 0 or ENXIO, as the block it replaces did.
+ */
 static int
-sweet_ufs_init(void)
+sweet_ufs_nodes(void)
+{
+	if (!sweet_ufs_dev_done) {
+		su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+		if (su.bmajor < 0) {
+			printf("SWEET UFS: bdevsw_add failed\n");
+			return ENXIO;
+		}
+		su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+		if (su.cmajor < 0) {
+			printf("SWEET UFS: cdevsw_add failed\n");
+			return ENXIO;
+		}
+		su.bdev = makedev(su.bmajor, 0);
+		sweet_ufs_dev_done = true;
+	}
+	if (!sweet_ufs_nodes_done &&
+	    devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0") &&
+	    devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0")) {
+		sweet_ufs_nodes_done = true;
+	}
+	return 0;
+}
+
+static int
+sweet_ufs_do_init(void)
 {
 	DTEntry node;
 	uintptr_t const *reg = NULL;
@@ -738,17 +774,9 @@ sweet_ufs_init(void)
 		return error;
 	}
 
-	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
-	if (su.bmajor < 0) {
+	if (sweet_ufs_nodes()) {
 		return ENXIO;
 	}
-	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
-	if (su.cmajor < 0) {
-		return ENXIO;
-	}
-	su.bdev = makedev(su.bmajor, 0);
-	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
-	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
 	/* Only now, with the partition bounds known, can writes be allowed. */
 	su.writable = (rw != 0);
 	su.ready = true;
@@ -775,6 +803,49 @@ sweet_ufs_init(void)
 	return 0;
 }
 
+static LCK_MTX_DECLARE(sweet_ufs_init_lock, &sweet_ufs_grp);
+
+/*
+ * One entry point for the UFS host: whoever gets here first (the early start
+ * before IOKit matching, or the root mount) does the work, the other waits on
+ * the lock and then finds su.ready.
+ */
+int
+sweet_ufs_init(void)
+{
+	int error = 0;
+
+	lck_mtx_lock(&sweet_ufs_init_lock);
+	if (!su.ready) {
+		error = sweet_ufs_do_init();
+	}
+	lck_mtx_unlock(&sweet_ufs_init_lock);
+	return error;
+}
+
+/*
+ * lena: bring up the UFS host and the persistent console log BEFORE
+ * PE_lockdown_iokit() starts the IOKit matching thread (startup.c calls this
+ * just before it). Any driver hang from there on is then still written to the
+ * partition and readable from a recovery with tools/sweet-log-pull.sh, so the
+ * phone screen no longer has to be filmed. Gated by boot-arg sweetdiag=1:
+ * without it the log starts with the root mount exactly as before.
+ */
+void
+sweet_ufs_early(void)
+{
+	int on = 0, error;
+
+	(void)PE_parse_boot_argn("sweetdiag", &on, sizeof(on));
+	if (on == 0) {
+		return;
+	}
+	printf("SWEET UFS: early start (before IOKit matching)\n");
+	error = sweet_ufs_init();
+	printf("SWEET UFS: early start -> %d%s\n", error,
+	    error ? "" : ", persistent console log running");
+}
+
 /*
  * Persistent console log ("sweetlog"). Filming the phone screen is the only
  * other way to see the console, so every character that reaches the
@@ -796,6 +867,7 @@ static char sweet_log_ring[SWEET_LOG_SIZE];
 static uint64_t _Atomic sweet_log_total;
 static int sweet_log_chan;
 static uint32_t sweet_log_secs = SWEET_LOG_SECS;
+static int sweet_log_fast;   /* lena diag: flush every 100 ms */
 
 /* Called for all console output, any context: never blocks. */
 void sweet_log_append(const char *c, int size);
@@ -858,43 +930,49 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
 	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
 	for (;;) {
-		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
 		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
-		if (total == flushed) {
-			continue;
-		}
-		uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
-		int error = 0;
-
-		lck_mtx_lock(&sweet_ufs_lock);
-		while (pos < total && !error) {
-			uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
-			uint32_t blk = off / UFS_BLOCK;
-			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
-			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
-			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
-			memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
-			error = ufs_write_blocks(base + 1 + blk, n);
-			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
-		}
-		if (!error) {
-			struct sweet_log_header h = {
-				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
-				.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
-			};
-			bzero(bounce, UFS_BLOCK);
-			memcpy(bounce, &h, sizeof(h));
-			error = ufs_write_blocks(base, 1);
-		}
-		if (!error) {
-			error = ufs_sync_cache();
-		}
-		lck_mtx_unlock(&sweet_ufs_lock);
-		if (error) {
-			printf("SWEET LOG: write failed (%d), stopping\n", error);
-			return;
+		if (total != flushed) {
+			uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
+			int error = 0;
+
+			lck_mtx_lock(&sweet_ufs_lock);
+			while (pos < total && !error) {
+				uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+				uint32_t blk = off / UFS_BLOCK;
+				uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+				uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+				    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+				memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+				error = ufs_write_blocks(base + 1 + blk, n);
+				pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+			}
+			if (!error) {
+				struct sweet_log_header h = {
+					.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+					.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
+				};
+				bzero(bounce, UFS_BLOCK);
+				memcpy(bounce, &h, sizeof(h));
+				error = ufs_write_blocks(base, 1);
+			}
+			if (!error) {
+				error = ufs_sync_cache();
+			}
+			lck_mtx_unlock(&sweet_ufs_lock);
+			if (error) {
+				printf("SWEET LOG: write failed (%d), stopping\n", error);
+				return;
+			}
+			flushed = total;
 		}
-		flushed = total;
+		/*
+		 * lena diag: sleep at the END of the round so the first flush happens
+		 * at once (whatever was printed before the log started), and, with
+		 * sweetdiag=1, every 100 ms instead of every ufslogsecs: a hard SoC
+		 * hang loses at most a tenth of a second of console.
+		 */
+		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog",
+		    sweet_log_fast ? MAX(hz / 10, 1) : hz * (int)sweet_log_secs);
 	}
 }
 
@@ -912,6 +990,11 @@ sweet_log_start(void)
 	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
 		sweet_log_secs = SWEET_LOG_SECS;
 	}
+	{
+		int diag = 0;
+		(void)PE_parse_boot_argn("sweetdiag", &diag, sizeof(diag));
+		sweet_log_fast = diag != 0;
+	}
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
@@ -923,12 +1006,12 @@ int sweet_ufs_rootdev(dev_t *dev);
 int
 sweet_ufs_rootdev(dev_t *dev)
 {
-	if (!su.ready) {
-		int error = sweet_ufs_init();
-		if (error) {
-			return error;
-		}
+	int error = sweet_ufs_init();
+	if (error) {
+		return error;
 	}
+	/* devfs exists by now (vfsinit()); an early start could not make them. */
+	sweet_ufs_nodes();
 	*dev = su.bdev;
 	return 0;
 }
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..59e8224 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -769,6 +769,18 @@ kernel_bootstrap_thread(void)
 #endif /* CONFIG_XNUPOST */
 
 #ifdef  IOKIT
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * lena: take over the UFS host and start the persistent console log
+	 * BEFORE the matching thread exists (PE_lockdown_iokit starts it), so a
+	 * driver that hangs on unported MMIO is still recorded on the partition.
+	 * No-op unless boot-arg sweetdiag=1.
+	 */
+	{
+		extern void sweet_ufs_early(void);
+		sweet_ufs_early();
+	}
+#endif
 	kernel_bootstrap_log("PE_lockdown_iokit");
 	PE_lockdown_iokit();
 #endif
