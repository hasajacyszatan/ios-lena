--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -513,15 +513,23 @@
 }
 
 /*
- * 0148: who is blocked on what. The 0147 boot answered the previous question
- * (the kernel is alive, the log flushes, and NO UFS command is in flight - no
- * "still waiting", counters frozen at 1517 cmds / 93 MiB): after
+ * 0148/0149/0151: who is blocked on what. The 0147 boot answered the previous
+ * question (the kernel is alive, the log flushes, and NO UFS command is in
+ * flight - no "still waiting", counters frozen at 1517 cmds / 93 MiB): after
  * `exec launchd_cache_loader` nothing reads the disk any more, so the stall is
  * a process waiting somewhere that is not the UFS driver. This dumps every
- * process with its uthreads' wait messages/channels, e.g.
- *   SWEET PS:   412 S launchd_cache_loader |vnode_sleep@0xffff...
- * which distinguishes a vnode/lock wait, a mach_msg nobody answers, a
- * psynch mutex, a memory wait, or simply a missing process (exec failed).
+ * process with its uthreads' wait channels, e.g.
+ *   SWEET PS:   412 S launchd_cache_loader |@0xffff...
+ * which distinguishes a vnode/lock wait, a mach_msg nobody answers, a psynch
+ * mutex, a memory wait, or simply a missing process (exec failed).
+ *
+ * 0151: the 0148 and 0149 boots both panicked inside the first dump (0149
+ * showed it even after the dump was moved past bsd_init: the ring stops at
+ * HB 34 s, right before the 35 s dump, again with no PS line), so the wait
+ * message STRING is no longer printed - a %s of a stale uu_wmesg is the
+ * obvious fault source - only the raw wait channel address, which cannot
+ * fault. Symbols can be resolved offline; what matters first is which process
+ * (and whether it exists at all), its state, and which channel it sits on.
  */
 extern unsigned int vm_page_free_count;
 
@@ -529,6 +537,7 @@
 sweet_diag_procs(void)
 {
 	struct proc *p;
+	int n = 0;
 
 	proc_list_lock();
 	for (p = allproc.lh_first; p != NULL; p = p->p_list.le_next) {
@@ -539,16 +548,16 @@
 		    (p->p_stat > 0 && p->p_stat <= 5) ? " ?IRSZ"[p->p_stat] : '?',
 		    p->p_comm);
 		TAILQ_FOREACH(ut, &p->p_uthlist, uu_list) {
-			if (ut->uu_wmesg != NULL) {
-				printf(" |%s@%p", ut->uu_wmesg, ut->uu_wchan);
-			} else if (ut->uu_wchan != NULL) {
-				printf(" |@%p", ut->uu_wchan);
+			if (ut->uu_wchan != NULL) {
+				printf(" @%p", ut->uu_wchan);
 			}
 		}
 		printf("\n");
 		proc_unlock(p);
+		n++;
 	}
 	proc_list_unlock();
+	printf("SWEET PS: %d processes, %u free pages\n", n, vm_page_free_count);
 }
 
 static void
@@ -580,8 +589,7 @@
 		}
 		if (!announced) {
 			announced = TRUE;
-			printf("SWEET PS: process dump every %d ms (pid state name | wmesg@wchan), free pages %u\n",
-			    period, vm_page_free_count);
+			printf("SWEET PS: process dump every %d ms (pid state name @wchan)\n", period);
 		}
 		sweet_diag_procs();
 	}
