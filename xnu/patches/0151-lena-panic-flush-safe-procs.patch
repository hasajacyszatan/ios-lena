--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -49,6 +49,8 @@
 extern void thread_deallocate(thread_t);
 extern int hz;
 static void sweet_log_start(void);
+/* 0151: set while the console ring is flushed from panic(); see ufs_scsi(). */
+static bool sweet_log_in_panic;
 extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
 extern void sweet_touch_init(void);
@@ -215,7 +217,14 @@
 	uint64_t deadline;
 	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
 	deadline += start;
-	bool sleepable = su.wait && su.ready && ml_get_interrupts_enabled() &&
+	/*
+	 * 0151: a flush from panic() must never sleep. The machine is about to
+	 * stop in the debugger, so nobody would wake the block - the flush would
+	 * turn a diagnosable panic into a silent hang with an empty ring. Spin
+	 * instead: a 4 KiB write completes in well under the 1 s log interval.
+	 */
+	bool sleepable = !sweet_log_in_panic &&
+	    su.wait && su.ready && ml_get_interrupts_enabled() &&
 	    !ml_at_interrupt_context() && get_preemption_level() == 0;
 	uint64_t spin_until = 0, sleep_interval = 0;
 	if (sleepable) {
@@ -997,21 +1006,82 @@
 	*kib = os_atomic_load(&su.read_kib, relaxed);
 }
 
+/*
+ * 0151: flush the console ring synchronously from the panic path, and share
+ * the flush position with the log thread. A panic stops every thread (the CPU
+ * spins in the debugger), so without this the last printed lines - including
+ * the panic text itself - stay in RAM and are lost: every panic then costs a
+ * photograph of the screen to read.
+ */
+static uint64_t sweet_log_flushed;
+static uint64_t sweet_log_seq;
+
 static void
-sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+sweet_log_flush_locked(boolean_t quiet)          /* sweet_ufs_lock held */
 {
 	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
-	uint64_t flushed = 0, seq = 0;
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t pos = total - sweet_log_flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : sweet_log_flushed;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	int error = 0;
+
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++sweet_log_seq,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	if (!quiet) {
+		if (error) {
+			printf("SWEET LOG: write failed (%d), stopping\n", error);
+		}
+	}
+	sweet_log_flushed = total;
+}
 
+void
+sweet_log_panic_flush(void)
+{
+	if (!su.ready || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	/*
+	 * Never block in a panic: if the panicking thread is inside the UFS
+	 * driver it already holds the lock, and waiting for it would deadlock
+	 * the machine for good.
+	 */
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+		return;
+	}
+	sweet_log_in_panic = true;
+	sweet_log_flush_locked(TRUE);
+	sweet_log_in_panic = false;
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
+
+static void
+sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
-	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, su.first_block + su.nblocks - SWEET_LOG_BLOCKS);
 	for (;;) {
-		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
-		if (total != flushed) {
-			uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
-			int error = 0;
-
+		if (os_atomic_load(&sweet_log_total, relaxed) != sweet_log_flushed) {
 			uint64_t lock_wait_ns = 0;
 
 			{
@@ -1025,34 +1095,8 @@
 				printf("SWEET LOG: flush blocked %llu s waiting for the UFS lock\n",
 				    lock_wait_ns / NSEC_PER_SEC);
 			}
-			while (pos < total && !error) {
-				uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
-				uint32_t blk = off / UFS_BLOCK;
-				uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
-				uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
-				    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
-				memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
-				error = ufs_write_blocks(base + 1 + blk, n);
-				pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
-			}
-			if (!error) {
-				struct sweet_log_header h = {
-					.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
-					.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = ++seq,
-				};
-				bzero(bounce, UFS_BLOCK);
-				memcpy(bounce, &h, sizeof(h));
-				error = ufs_write_blocks(base, 1);
-			}
-			if (!error) {
-				error = ufs_sync_cache();
-			}
+			sweet_log_flush_locked(FALSE);
 			lck_mtx_unlock(&sweet_ufs_lock);
-			if (error) {
-				printf("SWEET LOG: write failed (%d), stopping\n", error);
-				return;
-			}
-			flushed = total;
 		}
 		/*
 		 * lena diag: sleep at the END of the round so the first flush happens
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -86,6 +86,22 @@
 	}
 }
 
+/*
+ * 0151: the same text also goes to the persistent console ring, which is then
+ * flushed to UFS synchronously (bsd/dev/sweet_ufs.c). The flush thread is dead
+ * by then - a panic spins the CPU in the debugger - so without this the panic
+ * message never reaches the partition and every crash has to be photographed
+ * off the screen.
+ */
+extern void sweet_log_append(const char *c, int size);
+extern void sweet_log_panic_flush(void);
+
+static void
+sweet_early_ring_putc(char c)
+{
+	sweet_log_append(&c, 1);
+}
+
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
@@ -123,6 +139,18 @@
 	va_end(copy);
 	sweet_early_putc('\n');
 	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* 0151: persist the panic text before the debugger takes over. */
+	{
+		static const char prefix[] = "\nSWEET EARLY PANIC: ";
+
+		sweet_log_append(prefix, sizeof(prefix) - 1);
+		va_copy(copy, *args);
+		_doprnt(fmt, &copy, sweet_early_ring_putc, 16);
+		va_end(copy);
+		sweet_log_append("\n", 1);
+		sweet_log_panic_flush();
+	}
 }
 
